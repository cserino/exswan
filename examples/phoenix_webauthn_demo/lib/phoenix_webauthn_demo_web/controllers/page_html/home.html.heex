      />
      <defs>
        <linearGradient
          id=":S1:"
          x1="6.375"
          y1="45.5"
          x2="63.875"
          y2="6.5"
          gradientUnits="userSpaceOnUse"
        >
          <stop stop-color="#FE6316" />
          <stop offset="1" stop-color="#F0B90B" />
        </linearGradient>
      </defs>
    </svg>
    <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl">
      Phoenix WebAuthn Demo
    </h1>
    <p class="mt-6 text-lg leading-8 text-gray-600">
      Experience passwordless authentication with WebAuthn passkeys. This demo showcases secure,
      biometric authentication using the ex_webauthn library.
    </p>
    <div class="mt-10 flex items-center gap-x-6">
      <.link
        navigate={~p"/register"}
        class="btn btn-primary"
      >
        Get started
      </.link>
      <.link navigate={~p"/signin"} class="btn btn-ghost">
        Sign in <span aria-hidden="true">→</span>
      </.link>
    </div>

    <div class="mt-8 p-4 bg-blue-50 rounded-lg">
      <h3 class="text-sm font-medium text-blue-900">What you'll experience:</h3>
      <ul class="mt-2 text-sm text-blue-800 space-y-1">
        <li>• No passwords required</li>
        <li>• Biometric authentication (fingerprint, face ID)</li>
        <li>• Security key support</li>
        <li>• Cross-device synchronization</li>
      </ul>
    </div>
  </div>
</div>
